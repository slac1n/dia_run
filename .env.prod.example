APP_ENV=production
USE_MOCK_DATA=false
DATA_ROOT=data
CARELINK_TOKEN_FILE=/app/secrets/logindata.json
STRAVA_REFRESH_TOKEN_FILE=/app/secrets/strava-refresh-token.txt

# Strava OAuth
CLIENT_ID=
CLIENT_SECRET=

# Production S3 sync
S3_SYNC_ENABLED=true
S3_BUCKET=
S3_PREFIX=
S3_SYNC_ON_STARTUP=true
S3_SYNC_AFTER_FETCH=true
S3_SYNC_AFTER_QUESTIONNAIRE=true
AWS_REGION=

# AWS credentials for standard S3 access from inside the container
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PAGER=

# Nightly CareLink heartbeat (email alerts via AWS SES)
# HEARTBEAT_EMAIL_FROM must be a verified sender address in SES console.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY above are reused — just add ses:SendEmail to the IAM policy.
HEARTBEAT_EMAIL_FROM=alerts@yourdomain.com
HEARTBEAT_EMAIL_TO=you@yourpersonal.com

# Server bind (used by docker-compose.prod.yml)
UVICORN_HOST=10.44.0.1
UVICORN_PORT=8000

# OpenRouter (AI run recommendations)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=mistralai/mistral-small-2603
# Reasoning / thinking effort — passed through for models that support it
# (ignored by models that don't). Allowed: "", "low", "medium", "high".
OPENROUTER_REASONING_EFFORT=high
