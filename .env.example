# Strava OAuth
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Taiga (https://api.taiga.io)
TAIGA_AUTH_TOKEN=
TAIGA_REFRESH_TOKEN=
TAIGA_PROJECT_SLUG=slac1n-dia-run

# Mock data mode — set to true to use fixture data instead of real APIs
# When enabled, no real Strava/CareLink calls are made and ./data is untouched
USE_MOCK_DATA=false

# Runtime paths
APP_ENV=development
DATA_ROOT=data
CARELINK_TOKEN_FILE=logindata.json
STRAVA_REFRESH_TOKEN_FILE=

# Production S3 sync
S3_SYNC_ENABLED=false
S3_BUCKET=
S3_PREFIX=
S3_SYNC_ON_STARTUP=false
S3_SYNC_AFTER_FETCH=false
S3_SYNC_AFTER_QUESTIONNAIRE=false
AWS_REGION=

# Server bind (used by docker-compose.prod.yml)
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
